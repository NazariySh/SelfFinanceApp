@rendermode InteractiveServer

<AuthorizeView>
    <Authorized>
        <div class="dropdown">
            <button class="btn btn-light dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-2 fs-5" aria-hidden="true"></i>
                <span>@context.User.Identity!.Name</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item d-flex align-items-center" href="/profile">
                        <i class="bi bi-person me-2" aria-hidden="true"></i>
                        <span>Profile</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item d-flex align-items-center text-danger" href="/auth/logout">
                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>
                        <span>Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-link" href="/auth/login">Login</a>
        <a class="btn btn-link" href="/auth/register">Register</a>
    </NotAuthorized>
</AuthorizeView>
