@page "/auth/login"
@rendermode InteractiveServer

@inject ILogger<Login> logger
@inject IAuthenticationService authenticationService

<PageTitle>Login</PageTitle>

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-md-5 col-lg-4">
            <div class="app-card">
                <div class="text-center mb-4">
                    <i class="bi bi-box-arrow-in-right display-5 text-primary" aria-hidden="true"></i>
                    <h2 class="app-card-title mt-2">Sign in</h2>
                    <div class="app-section-subtitle">Welcome back. Please enter your credentials.</div>
                </div>

                <AlertInfo @bind-Message="AlertMessage" />

                <EditForm EditContext="EditContext" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label for="userName" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                            <InputText id="userName" class="form-control" @bind-Value="LoginModel.UserName" />
                        </div>
                        <ValidationMessage For="@(() => LoginModel.UserName)" />
                    </div>

                    <div class="form-group mt-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <InputText type="password" id="password" class="form-control" @bind-Value="LoginModel.Password" />
                        </div>
                        <ValidationMessage For="@(() => LoginModel.Password)" />
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary app-icon-btn justify-content-center">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            <span>Login</span>
                        </button>
                    </div>
                </EditForm>

                <p class="mt-3 text-center mb-0 text-muted">Don't have an account? <a href="/auth/register">Sign up</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    public EditContext EditContext { get; set; } = default!;
    public LoginDto LoginModel { get; set; } = new();
    public string? AlertMessage { get; set; }

    private ValidationMessageStore _validationMessageStore = default!;

    protected override void OnInitialized()
    {
        EditContext = new EditContext(LoginModel);
        _validationMessageStore = new ValidationMessageStore(EditContext);

        EditContext.OnFieldChanged += HandleFieldChanged;
    }

    private async Task LoginAsync()
    {
        try
        {
            await authenticationService.LoginAsync(LoginModel);

            navigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (ValidationException ex)
        {
            HandleValidationErrors(ex.Errors);
        }
        catch (HttpRequestException ex)
        {
            AlertMessage = $"Login failed. {ex.Message}";
        }
        catch (Exception ex)
        {
            logger.LogError($"Login failed. {ex.Message}");
        }
    }

    private void HandleValidationErrors(Dictionary<string, string> validationErrors)
    {
        _validationMessageStore.Clear();

        foreach (var (fieldName, errorMessage) in validationErrors)
        {
            _validationMessageStore.Add(EditContext.Field(fieldName), errorMessage);
        }

        EditContext.NotifyValidationStateChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _validationMessageStore.Clear(e.FieldIdentifier);
        EditContext.NotifyValidationStateChanged();
    }
}