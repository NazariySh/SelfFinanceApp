@using BlazorSelfFinanceApp.Components.Controls.Profile

@page "/auth/register"
@rendermode InteractiveServer

@inject IAccountService accountService

<PageTitle>Register</PageTitle>

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-md-5 col-lg-4">
            <div class="app-card">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus display-5 text-primary" aria-hidden="true"></i>
                    <h2 class="app-card-title mt-2">Create account</h2>
                    <div class="app-section-subtitle">Start tracking your finances today.</div>
                </div>

                <AlertInfo @bind-Message="AlertMessage" />

                <CreateProfileForm OnCreate="RegisterAsync" SubmitButtonText="Register" @bind-AlertMessage="AlertMessage" />

                <p class="mt-3 text-center mb-0 text-muted">Already have an account? <a href="/auth/login">Sign in</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    public string? AlertMessage { get; set; }

    private async Task RegisterAsync(AppUserForCreationDto appUserModel)
    {
        await accountService.CreateAsync(appUserModel);

        navigationManager.NavigateTo("/auth/login", forceLoad: true);
    }
}
