@using BlazorSelfFinanceApp.Components.Controls.Operations

@page "/operations/{id:guid}/edit"
@attribute [Authorize]

@inject IFinancialOperationService financialOperationService

<div class="app-form-card app-card">
    <div class="app-card-header">
        <div>
            <h2 class="app-card-title">
                <i class="bi bi-pencil-square me-2 text-primary" aria-hidden="true"></i>
                Edit Operation
            </h2>
            <div class="app-section-subtitle">Update the details of an existing operation.</div>
        </div>
    </div>

    <EditOperationForm OnLoadOperation="GetOperationAsync" OnEdit="EditOperationAsync" />
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Task<FinancialOperationDto?> GetOperationAsync()
    {
        return financialOperationService.GetByIdAsync(Id);
    }

    private async Task EditOperationAsync(FinancialOperationForUpdateDto operationModel)
    {
        await financialOperationService.UpdateAsync(Id, operationModel);

        navigationManager.NavigateTo("/", forceLoad: true);
    }
}
