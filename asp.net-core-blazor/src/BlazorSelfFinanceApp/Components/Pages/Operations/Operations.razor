@using BlazorSelfFinanceApp.Components.Controls.Operations

@inject IFinancialOperationService financialOperationService

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="mb-0">My Operations</h3>
        <div class="app-section-subtitle">All your recorded income and expenses.</div>
    </div>
    <a class="btn btn-primary app-icon-btn" href="/operations/create">
        <i class="bi bi-plus-circle" aria-hidden="true"></i>
        <span>Add Operation</span>
    </a>
</div>

<OperationsTable OnLoadData="LoadDataAsync" OnEdit="Edit" OnDelete="DeleteAsync" />

@code {
    private Task<PagedList<FinancialOperationDto>> LoadDataAsync(PaginationParameters parameters)
    {
        return financialOperationService.GetAllAsync(parameters);
    }

    private void Edit(Guid id)
    {
        navigationManager.NavigateTo($"/operations/{id}/edit");
    }

    private Task DeleteAsync(Guid id)
    {
        return financialOperationService.DeleteAsync(id);
    }
}
